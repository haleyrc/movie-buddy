{
    "name": "@haleylab/movie-buddy",
    "version": "0.0.1",
    "description": "An Obsidian plugin for creating and managing movie notes backed by TMDB data.",
    "author": "Ryan Haley",
    "license": "MIT",
    "main": "main.js",
    "type": "module",
    "scripts": {
        "audit": "npm audit --audit-level=low",
        "check": "npm run lint && npm run audit",
        "dev": "node esbuild.config.mjs",
        "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
        "version": "node version-bump.mjs && git add manifest.json versions.json",
        "lint": "eslint ."
    },
    "keywords": [
        "movie",
        "movies",
        "obsidian",
        "tmdb"
    ],
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "@types/mustache": "^4.2.6",
        "@types/node": "^22.15.17",
        "esbuild": "0.25.5",
        "eslint": "^9.39.4",
        "eslint-plugin-obsidianmd": "^0.4.2",
        "globals": "^17.6.0",
        "jiti": "^2.6.1",
        "obsidian": "latest",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.59.1"
    },
    "dependencies": {
        "mustache": "^4.2.0"
    }
}
